#!/usr/bin/env bash
# tools/fg/fg-series INSTANCE PREFIX "label|key=value key=value ..." ...
# Live A/B of [fg] settings in one running session (after Pharos's tools/fg-series): for each spec,
# sets the keys in the instance's threshold.ini ([fg] section; `quiver lab set --wait`), lets the
# pacing settle, takes the GPU lock and runs tools/fg/fg-trace, and prints the summary lines.
# Results: build-fg/fgtrace/PREFIX-LABEL/. Env: DX, PERIOD (spin), PRESENTS, SHOTS, BAND_Y, BAND_H, SETTLE (s).
set -uo pipefail
inst=$1 prefix=$2; shift 2
here=$(cd "$(dirname "$0")/../.." && pwd)
export QUIVER_SOURCE=${QUIVER_SOURCE:-agent:threshold-fg}
for spec in "$@"; do
  label=${spec%%|*}; kvs=${spec#*|}
  [[ $kvs == "$spec" ]] && kvs=""
  for kv in $kvs; do
    quiver lab set "$inst" "install:threshold.ini:[fg]${kv}" --wait >/dev/null || echo "$label: set $kv failed"
  done
  # settle: the interval EMA and count=auto (a few seconds of frames)
  python3 -I -c "import time; time.sleep(${SETTLE:-4})"
  d=$here/build-fg/fgtrace/$prefix-$label
  timeout 200 quiver lab gpu --for "$inst" -- "$here/tools/fg/fg-trace" "$inst" "$prefix-$label" "${DX:-2}" "${PERIOD:-2}" \
    "${PRESENTS:-480}" "${SHOTS:-240}" > /dev/null 2>&1 || echo "$label: trace failed"
  echo "##### $label ($kvs)"
  [[ -f $d/report.txt ]] && grep -E "span|interval G->R|interval R->G|interval G->G|interval \(all|arrival interval|shift ratio|outside|spin speed|residual vs|display vrr" "$d/report.txt" | cut -c1-170
  tail -n 2 "$d/perf.txt" 2>/dev/null | cut -c14-260 | sed 's/^/    /'
done
